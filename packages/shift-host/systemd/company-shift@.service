# One shift = one instance: company-shift@<shift>.service (e.g. company-shift@yoav-3).
# Persistent template, NOT systemd-run: transient units do not survive a reboot
# (bet 3). hq writes ~/.local/state/agent-company/shifts/<shift>/host-args.json,
# then `systemctl --user enable --now company-shift@<shift>`; `enable` makes the
# shift come back at boot (linger is on for ran). On restart the host sees its
# own log and resumes the same session id.
[Unit]
Description=agent-company shift %i
# a shift that fails the same way on every start stops after 5 tries in 5 minutes
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Environment=DISABLE_AUTOUPDATER=1
# The user manager's PATH (without the games dirs), with ~/.local/bin first: company-run (reserve) and company live there (install.sh).
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
# logs, spool, prime and sockets are owner-only
UMask=0077
ExecStart=/usr/bin/env node %h/projects/agent-company/packages/shift-host/src/cli.ts --args-file %h/.local/state/agent-company/shifts/%i/host-args.json
Restart=on-failure
RestartSec=1
# 75 = another host holds this shift; 76 = session id in use / spawn failed (needs hq);
# 2 = bad arguments. A requested stop exits 0. None of these may loop.
RestartPreventExitStatus=75 76 2
# hq first when the machine runs out (task 1505: 08/11, load 107 on 8 cores, swap full, hq frozen 11 minutes). Everything
# a shift runs (claude, its tests and builds) inherits these: less CPU than hq (Nice 0) when both want it, the same
# when it is free; and the OOM killer takes a shift (500) before hq (200, the user manager's).
Nice=5
OOMScoreAdjust=500
# Task 1547: Nice is per process, and hq and the shifts are in different cgroups, so between them the CPU goes by cgroup
# weight (hq's CPUWeight), not by Nice. Memory: every shift in one slice with a ceiling (app-shifts.slice), and each shift
# throttled past 4G. A working shift is 0.5GB at p99 (6 hours of samples on hq-host, 08/11); the one that reached 5.2GB ran
# `go vet` and two Go test links unreserved, the build that froze hq at 07:12. Throttled, not killed: it slows itself down,
# not the machine. A build under `company-run` runs in its own scope, outside the shift, with its lease's ceiling.
# Applied by `daemon-reload` to the shifts already running too (MemoryHigh; Slice and Nice only to new ones).
Slice=app-shifts.slice
MemoryHigh=4G
# mixed: SIGTERM to the host only (it closes claude's stdin gracefully), SIGKILL to the rest on timeout
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=default.target
