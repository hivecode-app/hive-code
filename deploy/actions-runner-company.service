# GitHub Actions runner for hivecode-app/hive-code (label "company"), as a user unit on hq-host.
# Runs .github/workflows/company-ci.yml. `scripts/deploy.sh hq` links it into ~/.config/systemd/user and
# reloads systemd; a changed unit takes effect at the next runner restart (never during a job).
[Unit]
Description=GitHub Actions runner (hivecode-app/hive-code, company-ci)
After=network-online.target

[Service]
WorkingDirectory=%h/actions-runner-company
ExecStart=%h/actions-runner-company/runsvc.sh
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min
Restart=always
RestartSec=10
MemoryMax=3G

[Install]
WantedBy=default.target
