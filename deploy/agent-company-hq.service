# company hq (B.1): one process on hq-host, a systemd --user unit (linger is on for ran).
# Installed by `scripts/deploy.sh hq` as a symlink in ~/.config/systemd/user to this file in ~/projects/agent-company.
# Shift-hosts run as their own units (company-shift@<shift>), outside this unit's cgroup, so
# restarting hq never kills a shift (B.5).
[Unit]
Description=agent-company hq (store, mailboxes, inbox, scheduler, watchdog, probes, API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/agent-company
ExecStart=/usr/bin/node %h/projects/agent-company/packages/hq/src/main.ts
Environment=NODE_ENV=production
# Server-side secrets, outside git, mode 600: DICTATE_TOKEN (dictate-server's token, packages/hq/src/dictate.ts).
# Written by `scripts/deploy.sh hq` from dictate-server's own .env. "-": hq still starts without it (the mic answers 503).
EnvironmentFile=-%h/.config/agent-company/hq.env
# Everything hq writes (db, backups, tokens, sockets) is owner-only.
UMask=0077
# State lives under ~/.local/state/agent-company (B.11), never /tmp.
# Always, including SIGKILL: a frozen hq is killed by its own freeze-watch thread (packages/hq/src/freeze-watch.ts) and comes back here.
Restart=always
RestartSec=2
# Task 1547: hq first when the machine runs out. Measured on hq-host (systemd 255, user manager), not assumed:
#  - CPU: CPUWeight 1000 against the shifts' slice (app-shifts.slice, 100): at load 107 hq gets ten times their share. The
#    shifts' Nice=5 never did this: Nice counts inside one cgroup, and hq is in another.
#  - OOM: 100 is the lowest a user unit can ask (its manager's own value; a negative one is cut to 100 quietly). Shifts are 500.
#  - Memory: not MemoryLow here. Protection holds only as far as every parent has it, and user@1001.service has none (that
#    needs root), so it would read as protection and do nothing. hq is kept by the ceiling on the shifts' slice instead.
#  - IO: no IOWeight. The io controller is not given to user units here, and the disk has no scheduler (`none`) for ioprio.
CPUWeight=1000
OOMScoreAdjust=100
TimeoutStopSec=20
KillMode=mixed

[Install]
WantedBy=default.target
