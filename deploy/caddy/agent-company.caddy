# Every public site of agent-company, and nothing else. `scripts/deploy.sh caddy` installs this file
# as /etc/caddy/sites/agent-company.caddy; the main /etc/caddy/Caddyfile pulls it in with
# `import sites/*.caddy`. Never edit the live copy: scripts/drift-check.sh reports any difference.
# No secrets here: hq checks every token itself, and hq holds dictate-server's credential
# (DICTATE_TOKEN in ~/.config/agent-company/hq.env, packages/hq/src/dictate.ts).

# The API for tools and the ci-host heartbeat. hq listens on 127.0.0.1:7420 only; everything except
# GET /health and /api/auth/* needs a token. WS /ws passes through.
api.hq.example.com {
	reverse_proxy 127.0.0.1:7420 {
		flush_interval -1
	}
}

# The app (packages/app): web build and APK from /var/www/hq-app/current, a release
# dir per commit (scripts/deploy.sh app). hq under /hq, dictation included (/hq/api/dictate/transcribe,
# device token only). Sign-in is a passkey or a pairing code (#23).
app.hq.example.com {
	encode zstd gzip

	handle_path /hq/* {
		reverse_proxy 127.0.0.1:7420 {
			flush_interval -1
		}
	}

	# The pairing link's page and the APK's key for this domain come from hq itself
	# (packages/hq/src/pairing.ts), the same on every server. Passkeys in the APK need assetlinks.json here.
	@pairing path /pair /.well-known/assetlinks.json
	handle @pairing {
		reverse_proxy 127.0.0.1:7420
	}

	# A QA copy of the web build (packages/app/tool/qa/publish_qa.sh), with its own way to hq.
	handle_path /qa/hq/* {
		reverse_proxy 127.0.0.1:7420 {
			flush_interval -1
		}
	}
	handle /qa/* {
		root * /var/www/hq-app
		header Cache-Control "no-cache"
		header X-Robots-Tag "noindex, nofollow"
		file_server
	}

	handle {
		root * /var/www/hq-app/current
		header Cache-Control "no-cache"
		header X-Robots-Tag "noindex, nofollow"
		try_files {path} /index.html
		file_server
	}
}

# Tab handoff (B.9, #50): the phone page for browser_ask_user. hq's own listener for it
# (cfg.tab.listen, 127.0.0.1:7422) serves only GET /h/<token> and WS /ws/<token>; Caddy passes only
# those two, so nothing else of hq is reachable through this host.
tab.hq.example.com {
	@handoff path /h/* /ws/*
	handle @handoff {
		reverse_proxy 127.0.0.1:7422
	}
	handle {
		respond "not found" 404
	}
}
